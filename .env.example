# JIZO - P3 environment template (owner: Aayush)
#
# Variable names follow AI-Build Documentation Appendix A.1 verbatim, so this
# file can be replaced by that block without edits.
#
# Copy to `.env` and adjust:
#
#   Copy-Item .env.example .env
#
# `.env` is gitignored (.gitignore line 151) and must NEVER be committed.
# This `.env.example` IS committed and holds placeholder values only.
#
# ---------------------------------------------------------------------------
# The upstreams are KEYLESS
# ---------------------------------------------------------------------------
# Doc Sec. 1: "Upstream demo APIs are free and keyless." There is therefore no
# WEATHER_API_KEY or GEOCODE_API_KEY. Open-Meteo and Nominatim need no auth.

# Upstream timeouts and retry bound - Doc Sec. 11.4
UPSTREAM_TIMEOUT=3.0
MAX_ATTEMPTS=3

# Backoff - Doc Sec. 11.4 / 4.3
#   delay = min(BACKOFF_INIT * 2**attempt + uniform(0, JITTER), BACKOFF_MAX)
BACKOFF_INIT=0.075
BACKOFF_MAX=1.8
JITTER=0.05
RETRY_BUDGET=2.2

# Circuit breaker - Doc Sec. 11.4 / 4.4
WINDOW=100
ERROR_PCT=25
VOLUME_MIN=20
SLEEP=10
PROBE_RATE=10/5s

# Enterprise timeout profile - Doc Sec. 4.2 (Pasunoori 2025 Sec. 7)
# Documented for the write-up; the demo uses UPSTREAM_TIMEOUT above.
SYNC_TIMEOUT_PROD=1.8
ASYNC_TIMEOUT_PROD=6.5

# Upstream bases - Doc Sec. 6.1 / Appendix A.1
OPENMETEO_BASE=https://api.open-meteo.com/v1/forecast
NOMINATIM_BASE=https://nominatim.openstreetmap.org/search

# Nominatim courtesy - Doc Sec. 10: custom User-Agent required, <= 1 rps.
NOMINATIM_UA=ResilientLogisticsDemo/1.0 (contact: team@example.com)
NOMINATIM_RPS=1

# Database - Doc Appendix A.1.
# NOTE the `+asyncpg` driver suffix: backend/db.py builds an ASYNC engine, so
# a plain `postgresql://` URL will fail at connect time.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/resilient

# Azure Key Vault - Doc Sec. 7.5. Prod only; blank locally.
# Auth is Managed Identity via azure-identity: no connection string by design.
AZURE_KEYVAULT_URL=